#!/usr/bin/env python3
"""Inspect and clean up BountyHarness network-isolation runs.

`bin/bb-run` creates one directory per isolated run under:

    ${BB_NETNS_STATE_DIR:-${XDG_RUNTIME_DIR:-~/.local/state/bountyharness}/netns}

Each directory holds the host scope-proxy Unix socket, the supervisor state
file, and run metadata. The namespace itself is owned by the supervisor process
and disappears with it; this helper only reports and reaps leftover state.

Usage:
    bb-netns status            # list runs and whether their processes are alive
    bb-netns stop <run>|--all  # terminate a run and remove its state
    bb-netns cleanup           # remove state for runs whose processes are gone
"""

from __future__ import annotations

import json
import os
import shutil
import signal
import sys
import time
from pathlib import Path

STATE_DIR = Path(os.environ.get(
    "BB_NETNS_STATE_DIR",
    str(Path(os.environ.get("XDG_RUNTIME_DIR", str(Path.home() / ".local/state/bountyharness"))) / "netns"),
))

EXPECTED_CMDLINE = {
    "supervisor": "tools/netns/supervisor.py",
    "proxy": "tools/scope_proxy.py",
}


def _read_json(path: Path) -> dict:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}


def _cmdline(pid: int) -> str:
    try:
        raw = Path(f"/proc/{pid}/cmdline").read_bytes()
    except OSError:
        return ""
    return raw.replace(b"\0", b" ").decode("utf-8", "replace")


def _alive(pid: int, kind: str) -> bool:
    if pid <= 0:
        return False
    try:
        os.kill(pid, 0)
    except OSError:
        return False
    marker = EXPECTED_CMDLINE[kind]
    return marker in _cmdline(pid)


def _runs() -> list[Path]:
    if not STATE_DIR.is_dir():
        return []
    return sorted(p for p in STATE_DIR.iterdir() if p.is_dir() and p.name.startswith("run-"))


def _describe(run: Path) -> dict:
    meta = _read_json(run / "meta.json")
    state = _read_json(run / "ns.state")
    proxy_pid = int(meta.get("proxy_pid") or 0)
    supervisor_pid = int(state.get("pid") or 0)
    return {
        "run": run.name,
        "skill": meta.get("skill", "?"),
        "workflow": meta.get("workflow", "?"),
        "safety_tier": meta.get("safety_tier", "?"),
        "started_at": meta.get("started_at") or state.get("started_at", ""),
        "proxy_pid": proxy_pid,
        "proxy_alive": _alive(proxy_pid, "proxy"),
        "supervisor_pid": supervisor_pid,
        "supervisor_alive": _alive(supervisor_pid, "supervisor"),
        "firewall": state.get("firewall", "(not recorded)"),
        "seccomp_raw_socket": state.get("seccomp_raw_socket", "(not recorded)"),
        "path": str(run),
    }


def cmd_status(_args: list[str]) -> int:
    runs = _runs()
    if not runs:
        print(f"no isolated runs under {STATE_DIR}")
        return 0
    rows = [_describe(r) for r in runs]
    width = max(len(r["run"]) for r in rows)
    for r in rows:
        live = "live" if r["supervisor_alive"] or r["proxy_alive"] else "stale"
        print(f"{r['run']:<{width}}  {live:<5}  {r['skill']}/{r['workflow']} [{r['safety_tier']}]")
        print(f"{'':<{width}}  proxy={r['proxy_pid']}({'up' if r['proxy_alive'] else 'down'}) "
              f"supervisor={r['supervisor_pid']}({'up' if r['supervisor_alive'] else 'down'})")
        print(f"{'':<{width}}  firewall={r['firewall']}  seccomp_raw_socket={r['seccomp_raw_socket']}")
    stale = sum(1 for r in rows if not (r["supervisor_alive"] or r["proxy_alive"]))
    if stale:
        print(f"\n{stale} stale run(s); run `bb-netns cleanup` to remove them")
    return 0


def _terminate(pid: int, kind: str) -> bool:
    if not _alive(pid, kind):
        return False
    try:
        os.kill(pid, signal.SIGTERM)
    except OSError:
        return False
    deadline = time.time() + 5
    while time.time() < deadline:
        if not _alive(pid, kind):
            return True
        time.sleep(0.1)
    try:
        os.kill(pid, signal.SIGKILL)
    except OSError:
        pass
    return True


def cmd_stop(args: list[str]) -> int:
    runs = _runs()
    if not args:
        print("usage: bb-netns stop <run>|--all", file=sys.stderr)
        return 2
    if args[0] == "--all":
        targets = runs
    else:
        targets = [r for r in runs if r.name == args[0] or r.name.startswith(args[0])]
        if not targets:
            print(f"no run matching {args[0]!r}", file=sys.stderr)
            return 1
    for run in targets:
        info = _describe(run)
        killed = []
        if _terminate(info["supervisor_pid"], "supervisor"):
            killed.append("supervisor")
        if _terminate(info["proxy_pid"], "proxy"):
            killed.append("proxy")
        shutil.rmtree(run, ignore_errors=True)
        print(f"stopped {run.name}" + (f" ({', '.join(killed)})" if killed else " (already stopped)"))
    return 0


def cmd_cleanup(_args: list[str]) -> int:
    removed = 0
    for run in _runs():
        info = _describe(run)
        if info["supervisor_alive"] or info["proxy_alive"]:
            continue
        shutil.rmtree(run, ignore_errors=True)
        removed += 1
        print(f"removed stale {run.name}")
    print(f"cleanup complete: {removed} stale run(s) removed")
    return 0


def main(argv: list[str]) -> int:
    if len(argv) < 2 or argv[1] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0 if len(argv) >= 2 else 2
    cmd, rest = argv[1], argv[2:]
    if cmd == "status":
        return cmd_status(rest)
    if cmd == "stop":
        return cmd_stop(rest)
    if cmd == "cleanup":
        return cmd_cleanup(rest)
    print(f"unknown command: {cmd}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
