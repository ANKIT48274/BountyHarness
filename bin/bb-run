#!/usr/bin/env bash
set -euo pipefail

# Resolve repo root through symlinks so PATH-installed copies work, then anchor
# execution there: workflow commands in skill.yaml use repo-relative paths.
_resolve_repo_root() {
  local src="${BASH_SOURCE[0]}" dir
  while [ -L "$src" ]; do
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    case "$src" in /*) ;; *) src="$dir/$src" ;; esac
  done
  cd -P "$(dirname "$src")/.." >/dev/null && pwd
}
REPO_ROOT="$(_resolve_repo_root)"
HARNESS_VERSION="$(cat "$REPO_ROOT/VERSION" 2>/dev/null || echo "unknown")"
export REPO_ROOT
# Prefer a formula-managed venv when present (brew install ships pyyaml there)
if [ -d "$REPO_ROOT/venv/bin" ]; then
  export PATH="$REPO_ROOT/venv/bin:$PATH"
fi
cd "$REPO_ROOT"

usage() {
  cat <<EOF
bb-run $HARNESS_VERSION - execute one workflow from a skill's skill.yaml

Usage:
  bb-run <skill> <workflow>     Run a workflow with the current RunContext
  bb-run list                   List all skills
  bb-run <skill> list           List workflows for one skill
  bb-run --help                 Show this help
  bb-run --version              Show version

Examples:
  bb-run recon passive-subdomains
  bb-run auth oauth-conformance
  bb-run identity-domain list

Workflows live in \$REPO_ROOT/.claude/skills/<skill>/skill.yaml.
Context comes from \$REPO_ROOT/.bb/context.env (run bb-init first).

Network isolation (non-passive workflows):
  Runs in a rootless user+network namespace with no external interface,
  nft default-deny (IPv4+IPv6), seccomp raw-socket deny, and a single
  egress path to the scope-enforcing proxy over AF_UNIX. Missing
  proxy/namespace/seccomp is a hard failure (exit 8) and the workflow
  command is never evaluated. Inspect runs with: bb-netns status

Exit codes: 0 ok, 2 circuit breaker, 3 missing scope, 4 out of scope,
            5 approval required, 6 destructive refused, 7 unparseable scope,
            8 isolation/proxy unavailable, 9 required tool missing.
EOF
}

if [ $# -ge 1 ]; then
  case "$1" in
    -h|--help|help) usage; exit 0 ;;
    -v|--version) echo "bb-run $HARNESS_VERSION"; exit 0 ;;
  esac
fi

# Discovery: list all skills
if [ "${1:-}" = "list" ]; then
  python3 - <<'PY'
import glob, sys, yaml
for p in sorted(glob.glob(".claude/skills/*/skill.yaml")):
    try:
        d = yaml.safe_load(open(p))
        desc = str(d.get("description", "")).splitlines()[0][:80] if d.get("description") else ""
        print(f"{d.get('name', p.split('/')[2]):20} {desc}")
    except Exception as e:
        print(f"{p}: parse error ({e})", file=sys.stderr)
PY
  exit 0
fi

if [ $# -lt 2 ]; then
  usage
  exit 1
fi

SKILL="$1"
WORKFLOW="$2"
SCRIPT_DIR="$REPO_ROOT/.claude/skills/${SKILL}"

if [ "$WORKFLOW" = "list" ] || [ "$WORKFLOW" = "-l" ]; then
  python3 - "$SCRIPT_DIR/skill.yaml" "$SKILL" <<'PY'
import sys
try:
    import yaml
except ImportError:
    __import__("subprocess").check_call([sys.executable, "-m", "pip", "install", "--break-system-packages", "-q", "pyyaml"])
    import yaml
d = yaml.safe_load(open(sys.argv[1]))
print(f"{sys.argv[2]} v{d.get('version', '?')} - {str(d.get('description','')).strip()[:100]}")
for name, wf in (d.get("workflows") or {}).items():
    tier = wf.get("safety_tier") or (d.get("safety_tier") or "?")
    desc = str(wf.get("description", "")).splitlines()[0][:70]
    print(f"  {name:28} [{tier:<14}] {desc}")
PY
  exit 0
fi

if [ ! -f "${SCRIPT_DIR}/skill.yaml" ]; then
  echo "ERROR: No skill.yaml found for '${SKILL}'"
  echo "Run 'bb-run list' to see available skills."
  exit 1
fi

# Source context and export it so preflight helpers see the same RunContext.
if [ -f "$REPO_ROOT/.bb/context.env" ]; then
  set -a
  # Runtime-generated env file; intentionally not a static source target
  # shellcheck source=/dev/null
  # shellcheck source=/dev/null
  source "$REPO_ROOT/.bb/context.env"
  set +a
  export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$HOME/google-cloud-sdk/google-cloud-sdk/bin:$HOME/.nvm/versions/node/v22.23.2/bin:$HOME/.pdtm/go/bin:$HOME/go/bin:$PATH"
else
  echo "Run bb-init first"
  exit 1
fi

# Find workflow by name — SKILL/WORKFLOW validated and passed via argv to avoid shell/python injection
if ! [[ "$SKILL" =~ ^[a-z0-9-]{1,64}$ ]] || ! [[ "$WORKFLOW" =~ ^[a-z0-9-]{1,64}$ ]]; then
  echo "ERROR: skill/workflow names must match ^[a-z0-9-]{1,64}$" >&2
  exit 1
fi
# Resolve SCRIPT_DIR via realpath and ensure it stays inside the skills tree
SCRIPT_DIR_RESOLVED="$(realpath "$SCRIPT_DIR" 2>/dev/null || echo "$SCRIPT_DIR")"
if [[ "$SCRIPT_DIR_RESOLVED" != "$REPO_ROOT/.claude/skills/"* ]]; then
  echo "ERROR: skill path escapes skills directory" >&2
  exit 1
fi
WF_CMD=$(python3 - "$SCRIPT_DIR/skill.yaml" "$WORKFLOW" <<'PY' 2>/dev/null
import sys, yaml
_, path, wf_name = sys.argv
with open(path) as f:
    data = yaml.safe_load(f)
for name, wf in (data.get('workflows') or {}).items():
    if name == wf_name:
        print(wf.get('command', ''))
        break
PY
)

if [ -z "$WF_CMD" ]; then
  echo "Workflow ${WORKFLOW} not found in ${SKILL}/skill.yaml"
  echo "Available workflows:"
  python3 - "$SCRIPT_DIR/skill.yaml" <<'PY' 2>/dev/null
import sys, yaml
with open(sys.argv[1]) as f:
    data = yaml.safe_load(f)
for name in data.get('workflows', {}) or {}:
    print(f'  {name}')
PY
  exit 1
fi

# Preflight checks
python3 - "$WF_CMD" "${SCRIPT_DIR}" "${SKILL}" "${WORKFLOW}" <<'PY'
import os, re, shlex, shutil, sys, glob, yaml
cmd, sdir, skill, wf = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
registry = {}
for f in glob.glob(os.environ["REPO_ROOT"] + "/tools/registry/*.yaml"):
    try:
        for t in yaml.safe_load(open(f)).get("registry", {}).get("tools", []):
            name = t.get("name", "")
            binary = t.get("binary", name)
            if name:
                registry[name] = t
            if binary:
                registry[binary] = t
    except Exception:
        pass
try:
    # Normalise shell line continuations first: in a YAML block scalar the
    # command is "mkdir ... && \\\nfrida ...", and shlex turns that into a
    # token "\nfrida" which never matches the registry. That silently
    # disabled the missing-tool guard for multi-line workflows.
    normalized = cmd.replace("\\\n", " ").replace("\n", " ")
    tokens = set(shlex.split(normalized))
except Exception:
    tokens = set(re.findall(r"[A-Za-z0-9_.+-]+", cmd))
command_words = set()
for token in tokens:
    base = os.path.basename(token.strip())
    if base in registry:
        command_words.add(base)
try:
    with open(f"{sdir}/skill.yaml") as f:
        data = yaml.safe_load(f)
    missing = []
    for t in data.get("tools_required", []):
        info = registry.get(t, {})
        binary = info.get("binary", t)
        if t in command_words or binary in command_words:
            if not shutil.which(binary):
                missing.append(f"{t} (binary: {binary})")
    if missing and os.environ.get("BB_ALLOW_MISSING_TOOLS") != "1":
        print("ERROR: required tool(s) not on PATH: " + ", ".join(missing), file=sys.stderr)
        print(f"  Fix: bin/bb-tools install <tool>  |  bin/bb-tools doctor --skill {skill}", file=sys.stderr)
        print("  Set BB_ALLOW_MISSING_TOOLS=1 only when the workflow degrades gracefully.", file=sys.stderr)
        sys.exit(9)
except SystemExit:
    raise
except Exception:
    pass
intrusive = {name for name, info in registry.items() if info.get("risk_tier") in ("intrusive", "destructive-manual")}
if command_words & {"nuclei", "ffuf", "dalfox", "katana"} and not os.environ.get("RATE_LIMIT"):
    print("HINT: Set RATE_LIMIT in .bb/context.env to avoid getting blocked")
PY

# Authorization gate: hard block before any command is evaluated.
# passive runs freely; active-safe+ needs a valid scope file matching TARGET;
# intrusive+ needs BB_APPROVED_TIER; destructive-manual never runs.
python3 "$REPO_ROOT/tools/workflow_gate.py" \
  --skill-dir "$SCRIPT_DIR" \
  --workflow "$WORKFLOW" \
  --command "$WF_CMD" \
  --target "${TARGET:-}" \
  --port "${TARGET_PORT:-0}" \
  --scheme "${TARGET_SCHEME:-}" \
  --scope-file "${SCOPE_FILE:-}"
GATE_EXIT=$?
if [ "$GATE_EXIT" -ne 0 ]; then
  echo "AUTHORIZATION GATE: refusing to run ${SKILL}/${WORKFLOW} (exit $GATE_EXIT)" >&2
  exit "$GATE_EXIT"
fi

# Substitute longest variable names first so $TARGET_URL is not partially
# rewritten as ${TARGET}_URL. Values are shell-quoted to prevent injection
# if OUTDIR/TARGET contain metachars (see docs/threat-model.md §2).
WF_CMD="${WF_CMD//\$EVIDENCE_DIR/$(printf %q "$EVIDENCE_DIR")}"
WF_CMD="${WF_CMD//\$TARGET_URL/$(printf %q "$TARGET_URL")}"
WF_CMD="${WF_CMD//\$TARGET_HOST/$(printf %q "${TARGET_HOST:-$TARGET}")}"
WF_CMD="${WF_CMD//\$OUTDIR/$(printf %q "$OUTDIR")}"
WF_CMD="${WF_CMD//\$TARGET/$(printf %q "$TARGET")}"

STARTED_AT=$(date -u +%Y-%m-%dT%H:%M:%SZ)
TARGET_HASH=$(echo -n "${TARGET:-}" | shasum -a 256 | cut -d' ' -f1)

# Circuit breaker: refuse to run when target is in cooldown (consecutive
# failures or explicit rate-limit flag). Exit 2 = blocked, not a workflow error.
python3 "$REPO_ROOT/tools/circuit_breaker.py" check --target-hash "$TARGET_HASH" || exit 2

SCOPE_HASH=""
if [ -n "${SCOPE_FILE:-}" ] && [ -f "$SCOPE_FILE" ]; then
  SCOPE_HASH=$(shasum -a 256 "$SCOPE_FILE" | cut -d' ' -f1)
fi
# Resolve the same tier the authorization gate uses (workflow metadata first,
# then skill metadata, then tools). Keeping one resolver prevents bb-run from
# treating an active-safe workflow as passive and skipping network isolation.
SAFETY_TIER=$(python3 "$REPO_ROOT/tools/workflow_gate.py" \
  --skill-dir "$SCRIPT_DIR" \
  --workflow "$WORKFLOW" \
  --command "$WF_CMD" \
  --print-tier 2>/dev/null || echo "intrusive")
case "$SAFETY_TIER" in
  passive|active-safe|intrusive|destructive-manual) ;;
  *) SAFETY_TIER="intrusive" ;;
esac
SKILL_TOOLS=$(python3 - "$SCRIPT_DIR/skill.yaml" <<'PY' 2>/dev/null
import sys, yaml
with open(sys.argv[1]) as f:
    tools = yaml.safe_load(f).get('tools_required', []) or []
print(' '.join(str(t) for t in tools))
PY
)
SKILL_TOOLS="${SKILL_TOOLS:-}"

# ---------------------------------------------------------------------------
# OS-level network isolation for non-passive workflows.
#
# Every non-passive workflow runs inside a rootless user+network namespace
# (`unshare -Urn`) that has:
#   * no external interface and no default route,
#   * an nftables default-deny ruleset covering IPv4 and IPv6,
#   * raw/packet socket creation denied by an inherited seccomp filter,
#   * exactly one egress path: a 127.0.0.1 TCP bridge to the host scope proxy
#     over an AF_UNIX socket.
# The host proxy checks every destination against SCOPE_FILE and pins DNS.
# Passive workflows are third-party OSINT only (no scope file required) and
# stay on the host; this is documented in BOUNTY_READINESS_REPORT.md.
#
# There is deliberately no agent-settable switch to run a non-passive workflow
# on the host network: a missing proxy, namespace, or seccomp filter is a hard
# failure (exit 8) and the workflow command is never evaluated.
# ---------------------------------------------------------------------------
ISOLATION_STATE_DIR="${BB_NETNS_STATE_DIR:-${XDG_RUNTIME_DIR:-$HOME/.local/state/bountyharness}/netns}"
RUN_TOKEN="run-$$-$(date +%s)"
RUN_DIR="$ISOLATION_STATE_DIR/$RUN_TOKEN"
PROXY_PID=""
SUPERVISOR_PID=""
ISOLATION_ACTIVE=0
ISOLATION_FAILED=0

# Exit trap: kill isolation helpers and remove the run state dir. The body is
# inlined rather than a named function referenced only by `trap` because
# ShellCheck 0.11 (SC2329) does not treat trap-registered functions as invoked.
# TRAP_RC is pre-initialised so the original exit status survives cleanup.
TRAP_RC=0
trap '
  TRAP_RC=$?
  if [ -n "$SUPERVISOR_PID" ]; then
    kill "$SUPERVISOR_PID" 2>/dev/null || true
    wait "$SUPERVISOR_PID" 2>/dev/null || true
    SUPERVISOR_PID=""
  fi
  if [ -n "$PROXY_PID" ]; then
    kill "$PROXY_PID" 2>/dev/null || true
    wait "$PROXY_PID" 2>/dev/null || true
    PROXY_PID=""
  fi
  rm -rf "$RUN_DIR"
  exit "$TRAP_RC"
' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

if [ "$SAFETY_TIER" != "passive" ]; then
  if ! command -v unshare >/dev/null 2>&1; then
    echo "BLOCKED: network isolation unavailable (unshare not found)" >&2
    ISOLATION_FAILED=1
  fi
  if [ "$(cat /proc/sys/kernel/unprivileged_userns_clone 2>/dev/null || echo 1)" != "1" ]; then
    echo "BLOCKED: network isolation unavailable (unprivileged user namespaces disabled)" >&2
    ISOLATION_FAILED=1
  fi
  if [ -z "${SCOPE_FILE:-}" ] || [ ! -f "$SCOPE_FILE" ]; then
    echo "BLOCKED: network isolation requires a non-empty SCOPE_FILE" >&2
    ISOLATION_FAILED=1
  fi

  if [ "$ISOLATION_FAILED" = "0" ]; then
    if ! mkdir -p "$RUN_DIR" 2>/dev/null; then
      echo "BLOCKED: cannot create isolation state directory $RUN_DIR (exit 8)" >&2
      ISOLATION_FAILED=1
    fi
  fi

  if [ "$ISOLATION_FAILED" = "0" ]; then
    chmod 700 "$ISOLATION_STATE_DIR" "$RUN_DIR" 2>/dev/null || true
    PROXY_SOCK="$RUN_DIR/p.sock"
    PROXY_READY="$RUN_DIR/proxy.ready"
    PROXY_LOG="$REPO_ROOT/.bb/scope-proxy.log"
    mkdir -p "$REPO_ROOT/.bb"
    PROXY_ARGS=(--scope-file "$SCOPE_FILE" --unix-socket "$PROXY_SOCK"
                --ready-file "$PROXY_READY" --log "$PROXY_LOG" --parent-death)
    if [ "${BB_SCOPE_ALLOW_PRIVATE:-0}" = "1" ]; then
      PROXY_ARGS+=(--allow-private)
    fi
    python3 "$REPO_ROOT/tools/scope_proxy.py" "${PROXY_ARGS[@]}" >/dev/null 2>"$RUN_DIR/proxy.err" &
    PROXY_PID=$!
    for _ in $(seq 1 50); do
      [ -s "$PROXY_READY" ] && break
      kill -0 "$PROXY_PID" 2>/dev/null || break
      sleep 0.1
    done
    if [ ! -s "$PROXY_READY" ] || ! kill -0 "$PROXY_PID" 2>/dev/null; then
      echo "BLOCKED: scope proxy failed to start; refusing to run ${SKILL}/${WORKFLOW} (exit 8)" >&2
      cat "$RUN_DIR/proxy.err" >&2 2>/dev/null || true
      ISOLATION_FAILED=1
    else
      cat > "$RUN_DIR/meta.json" <<EOF
{"proxy_pid": ${PROXY_PID}, "skill": "$SKILL", "workflow": "$WORKFLOW",
 "safety_tier": "$SAFETY_TIER", "run_dir": "$RUN_DIR", "proxy_socket": "$PROXY_SOCK",
 "started_at": "$STARTED_AT"}
EOF
      ISOLATION_ACTIVE=1
      echo "NETWORK ISOLATION: rootless netns (nft default-deny IPv4/IPv6, seccomp raw-socket deny)"
      echo "SCOPE PROXY: AF_UNIX ${PROXY_SOCK} (mode 0600; DNS pinned; redirects re-checked)"
    fi
  fi

  if [ "$ISOLATION_FAILED" = "1" ]; then
    # Fail closed: record the failure and exit 8 without evaluating WF_CMD.
    EXIT_CODE=8
  fi
fi

if [ "$ISOLATION_FAILED" = "1" ]; then
  echo "=== BLOCKED: ${SKILL}/${WORKFLOW} not executed (isolation unavailable) ===" >&2
else
  echo "=== Running: ${SKILL}/${WORKFLOW} ==="
  echo "$WF_CMD"
  if [ "$ISOLATION_ACTIVE" = "1" ]; then
    if [ "${BB_ISOLATION_TEST_FAIL:-0}" = "1" ]; then
      # Fail-closed test hook: proves exit 8 without evaluating the workflow.
      echo "BLOCKED: simulated isolation failure (BB_ISOLATION_TEST_FAIL=1)" >&2
      EXIT_CODE=8
    else
      set +e
      unshare -Urn python3 "$REPO_ROOT/tools/netns/supervisor.py" \
        --proxy-socket "$PROXY_SOCK" \
        --ready-file "$RUN_DIR/ns.ready" \
        --state-file "$RUN_DIR/ns.state" \
        --timeout "${BB_WORKFLOW_TIMEOUT:-0}" \
        --cwd "$REPO_ROOT" \
        -- bash -c "$WF_CMD" &
      SUPERVISOR_PID=$!
      wait "$SUPERVISOR_PID"
      EXIT_CODE=$?
      SUPERVISOR_PID=""
      set -e
      if [ ! -s "$RUN_DIR/ns.state" ]; then
        echo "BLOCKED: network namespace did not start; workflow not executed (exit 8)" >&2
        EXIT_CODE=8
      elif [ "$EXIT_CODE" -eq 80 ]; then
        echo "BLOCKED: network isolation could not be established; workflow not executed (exit 8)" >&2
        EXIT_CODE=8
      fi
    fi
  else
    set +e
    eval "$WF_CMD"
    EXIT_CODE=$?
    set -e
  fi
fi

ENDED_AT=$(date -u +%Y-%m-%dT%H:%M:%SZ)
S_SECS=$(python3 -c "import datetime,sys; d=datetime.datetime.strptime(sys.argv[1],'%Y-%m-%dT%H:%M:%SZ'); print(int(d.timestamp()*1000))" "$STARTED_AT")
E_SECS=$(python3 -c "import datetime,sys; d=datetime.datetime.strptime(sys.argv[1],'%Y-%m-%dT%H:%M:%SZ'); print(int(d.timestamp()*1000))" "$ENDED_AT")
DURATION_MS=$((E_SECS - S_SECS))

# Intentional word split below: each tool name becomes its own --tools-required arg
# shellcheck disable=SC2086
python3 "$REPO_ROOT/tools/run_trace.py" record \
  --skill "$SKILL" \
  --workflow "$WORKFLOW" \
  --safety-tier "$SAFETY_TIER" \
  --exit-code "$EXIT_CODE" \
  --duration-ms "$DURATION_MS" \
  --target-hash "$TARGET_HASH" \
  --program "${PROGRAM:-}" \
  --scope-file-hash "$SCOPE_HASH" \
  --tools-required $SKILL_TOOLS \
  --started-at "$STARTED_AT" \
  --ended-at "$ENDED_AT"

exit "$EXIT_CODE"
